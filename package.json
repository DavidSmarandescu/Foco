{
  "name": "foco",
  "productName": "Foco",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "description": "Graba tus sesiones de estudio en cámara rápida y lleva tu racha. Sin conexión y sin servidores.",
  "author": "David Smarandescu",
  "homepage": "https://github.com/DavidSmarandescu/Foco",
  "type": "module",
  "main": "electron/main.cjs",
  "desktopName": "foco.desktop",
  "scripts": {
    "predev": "node scripts/copy-mediapipe.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-mediapipe.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "TZ=Europe/Madrid vitest run",
    "predesktop:dev": "node scripts/copy-mediapipe.mjs",
    "desktop:dev": "concurrently -k -n web,app \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && cross-env FOCO_DEV_URL=http://localhost:5173 electron .\"",
    "desktop": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --publish never",
    "dist": "electron-builder --publish never",
    "e2e:desktop": "node scripts/e2e-desktop.cjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "electron": "^44.10.1",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.7",
    "idb": "^8.0.4",
    "mediabunny": "^1.65.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.8.3",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.davidsmarandescu.foco",
    "productName": "Foco",
    "copyright": "© 2026 David Smarandescu",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!dist/**/*.map"
    ],
    "asar": true,
    "artifactName": "Foco-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSCameraUsageDescription": "Foco usa la cámara para grabar tus sesiones de estudio en cámara rápida y pausar cuando no estás. Las imágenes no salen de tu ordenador."
      }
    },
    "dmg": {
      "title": "Foco ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Foco",
      "artifactName": "Foco-${version}-windows-setup.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Education",
      "synopsis": "Estudia en cámara rápida y lleva tu racha",
      "syncDesktopName": true
    }
  }
}
